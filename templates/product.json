              "settings": {
                "custom_liquid": "<div class=\"product-block selluxe-sales-point selluxe_sales_point_NXf693\"><style data-shopify=\"\">.selluxe_sales_point_NXf693 {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      width: 100%;\n      padding: 0px 0px;\n      background: ;\n      margin: 0px 0 -15px;\n      border-radius: 0px;\n    }\n    .selluxe_sales_point_NXf693 .icon {\n      width: 24px;\n      height: 24px;\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .selluxe_sales_point_NXf693 .icon .dot-icon {\n      position: absolute;\n    }\n    .selluxe_sales_point_NXf693 .icon .dot-icon.dot-animated {\n      animation: pulse 2s infinite;\n    }\n    .selluxe_sales_point_NXf693 .text span {\n      font-size: 15px;\n      color: #e20b0b;\n      line-height: 150%;\n    }\n    \n    @keyframes pulse {\n      from {\n        transform: scale(1);\n        opacity: 1;\n      } \n      to {\n        transform: scale(2.4);\n        opacity: 0;\n      }\n    }</style><div class=\"icon\"><style data-shopify=\"\">.selluxe_sales_point_NXf693 .icon {\n          color: #e20b0b;\n        }</style><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"#e20b0b\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"dot-icon dot-animated\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg>\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"#e20b0b\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"dot-icon\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></div>\n  <div class=\"text\">\n    <span><strong>Only a few left in stock</strong></span>\n  </div>\n\n  <script>\n      const selluxe_sales_point_NXf693_deliveryDays = 1; \n      const selluxe_sales_point_NXf693_currentDate = new Date();\n      selluxe_sales_point_NXf693_currentDate.setDate(selluxe_sales_point_NXf693_currentDate.getDate() + selluxe_sales_point_NXf693_deliveryDays);\n      \n      const selluxe_sales_point_NXf693_day = selluxe_sales_point_NXf693_currentDate.getDate();\n      let selluxe_sales_point_NXf693_formatDay = '';\n      if(selluxe_sales_point_NXf693_day > 10) {\n        const day = selluxe_sales_point_NXf693_day % 10;\n        if(day === 1) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'st';\n        }\n        if(day === 2) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'nd';\n        }\n        if(day === 3) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'rd';\n        }\n        if(day > 3) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'th';\n        }\n        \n      } else {\n        if(selluxe_sales_point_NXf693_day === 1) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'st';\n        }\n        if(selluxe_sales_point_NXf693_day === 2) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'nd';\n        }\n        if(selluxe_sales_point_NXf693_day === 3) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'rd';\n        }\n        if(selluxe_sales_point_NXf693_day > 3) {\n          selluxe_sales_point_NXf693_formatDay = selluxe_sales_point_NXf693_day + 'th';\n        }\n      }\n      \n      const selluxe_sales_point_NXf693_year = selluxe_sales_point_NXf693_currentDate.getFullYear();\n  \n      const selluxe_sales_point_NXf693_monthOptions = { month: 'long' };\n      const selluxe_sales_point_NXf693_monthName = selluxe_sales_point_NXf693_currentDate.toLocaleString('en-US', selluxe_sales_point_NXf693_monthOptions);\n  \n      const selluxe_sales_point_NXf693_dayIndex = selluxe_sales_point_NXf693_currentDate.getDay();\n      const selluxe_sales_point_NXf693_weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n      const selluxe_sales_point_NXf693_weekdayName = selluxe_sales_point_NXf693_weekdays[selluxe_sales_point_NXf693_dayIndex];\n\n      const selluxe_sales_point_NXf693_text = document.querySelector('.selluxe_sales_point_NXf693 .text span');\n      let selluxe_sales_point_NXf693_newText = selluxe_sales_point_NXf693_text.innerHTML\n\n      selluxe_sales_point_NXf693_newText = selluxe_sales_point_NXf693_newText.replace('[weekday]', selluxe_sales_point_NXf693_weekdayName);\n      selluxe_sales_point_NXf693_newText = selluxe_sales_point_NXf693_newText.replace('[day]', selluxe_sales_point_NXf693_formatDay);\n      selluxe_sales_point_NXf693_newText = selluxe_sales_point_NXf693_newText.replace('[year]', selluxe_sales_point_NXf693_year);\n      selluxe_sales_point_NXf693_newText = selluxe_sales_point_NXf693_newText.replace('[month]', selluxe_sales_point_NXf693_monthName);\n\n      selluxe_sales_point_NXf693_text.innerHTML = selluxe_sales_point_NXf693_newText;\n    </script>\n</div>"
