            "custom_liquid_RzqbLD": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n  .northline-stock-box {\n    width: 100%;\n    padding: 12px 15px;\n    background: #f5f7fc;\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .northline-stock-box * {\n    box-sizing: border-box;\n  }\n\n  .northline-stock-row {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    min-height: 38px;\n  }\n\n  .northline-stock-row + .northline-stock-row {\n    margin-top: 7px;\n  }\n\n  .northline-stock-icon {\n    width: 25px;\n    height: 25px;\n    flex: 0 0 25px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #171717;\n  }\n\n  .northline-stock-icon svg {\n    display: block;\n    width: 23px;\n    height: 23px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .northline-stock-text {\n    margin: 0;\n    color: #171717;\n    font-size: 17px;\n    line-height: 1.35;\n    font-weight: 500;\n    letter-spacing: .1px;\n  }\n\n  /* Animated stock indicator */\n  .northline-stock-indicator {\n    position: relative;\n    width: 25px;\n    height: 25px;\n    flex: 0 0 25px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #c9141e;\n  }\n\n  .northline-stock-indicator .pulse-ring,\n  .northline-stock-indicator .pulse-dot {\n    position: absolute;\n    width: 12px;\n    height: 12px;\n    border-radius: 50%;\n    background: #c9141e;\n  }\n\n  .northline-stock-indicator .pulse-ring {\n    animation: northline-stock-pulse 2s ease-out infinite;\n  }\n\n  .northline-stock-indicator .pulse-dot {\n    z-index: 1;\n  }\n\n  .northline-stock-row--low-stock .northline-stock-text {\n    color: #c9141e;\n    font-size: 18px;\n    font-weight: 700;\n  }\n\n  @keyframes northline-stock-pulse {\n    0% {\n      transform: scale(1);\n      opacity: .7;\n    }\n    100% {\n      transform: scale(2.5);\n      opacity: 0;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .northline-stock-indicator .pulse-ring {\n      animation: none;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .northline-stock-box {\n      padding: 11px 10px;\n    }\n\n    .northline-stock-row {\n      gap: 10px;\n      min-height: 34px;\n    }\n\n    .northline-stock-icon {\n      width: 23px;\n      height: 23px;\n      flex-basis: 23px;\n    }\n\n    .northline-stock-icon svg {\n      width: 21px;\n      height: 21px;\n    }\n\n    .northline-stock-indicator {\n      width: 23px;\n      height: 23px;\n      flex-basis: 23px;\n    }\n\n    .northline-stock-text {\n      font-size: 14px;\n    }\n\n    .northline-stock-row--low-stock .northline-stock-text {\n      font-size: 15px;\n    }\n  }\n</style>\n\n<div class=\"northline-stock-box\">\n\n  <!-- FREE SHIPPING -->\n  <div class=\"northline-stock-row\">\n    <span class=\"northline-stock-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M2 7h12v11H2z\"/>\n        <path d=\"M14 11h4l4 4v3h-8\"/>\n        <circle cx=\"6.5\" cy=\"19\" r=\"2\"/>\n        <circle cx=\"17.5\" cy=\"19\" r=\"2\"/>\n      </svg>\n    </span>\n    <p class=\"northline-stock-text\">\n      Free Home Delivery via UPS\n    </p>\n  </div>\n\n  <!-- 30-DAY TRIAL -->\n  <div class=\"northline-stock-row\">\n    <span class=\"northline-stock-icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"m12 2 9 4.5-9 4.5-9-4.5L12 2Z\"/>\n        <path d=\"M3 6.5v11L12 22l9-4.5v-11\"/>\n        <path d=\"M12 11v11\"/>\n      </svg>\n    </span>\n    <p class=\"northline-stock-text\">\n      30-Day Risk-Free Trial\n    </p>\n  </div>\n\n  <!-- ANIMATED LOW STOCK -->\n  <div class=\"northline-stock-row northline-stock-row--low-stock\">\n    <span class=\"northline-stock-indicator\" aria-hidden=\"true\">\n      <span class=\"pulse-ring\"></span>\n      <span class=\"pulse-dot\"></span>\n    </span>\n    <p class=\"northline-stock-text\">\n      Only a few left in stock\n    </p>\n  </div>\n\n</div>"
