ze: 17px;\n    }\n\n    .nl-trust-row {\n      grid-template-columns: 21px minmax(0, 1fr);\n      gap: 9px;\n      padding: 10px 12px;\n    }\n\n    .nl-trust-icon {\n      width: 18px;\n      height: 18px;\n    }\n\n    .nl-trust-text {\n      font-size: 12px;\n      line-height: 1.4;\n    }\n  }\n</style>\n\n<div class=\"nl-trust\">\n  <div class=\"nl-trust-card\">\n\n    <!-- STAR RATING -->\n    <div class=\"nl-trust-header\">\n      <div\n        class=\"nl-trust-stars\"\n        role=\"img\"\n        aria-label=\"5 out of 5 stars\"\n      >\n        <span class=\"nl-trust-star\">★</span>\n        <span class=\"nl-trust-star\">★</span>\n        <span class=\"nl-trust-star\">★</span>\n        <span class=\"nl-trust-star\">★</span>\n        <span class=\"nl-trust-star\">★</span>\n      </div>\n\n      <p class=\"nl-trust-rating\">Excellent</p>\n    </div>\n\n    <!-- CUSTOMER TRUST -->\n    <div class=\"nl-trust-row\">\n      <span class=\"nl-trust-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M12 3 21 7v5c0 4.5-3.8 7.6-9 10-5.2-2.4-9-5.5-9-10V7l9-4Z\"/>\n          <path d=\"m7 11 3.2 3.2L17 8\"/>\n        </svg>\n      </span>\n\n      <p class=\"nl-trust-text\">\n        RATED EXCELLENT BY 9,700+ HAPPY SHOPPERS\n      </p>\n    </div>\n\n    <!-- RISK-FREE TRIAL -->\n    <div class=\"nl-trust-row\">\n      <span class=\"nl-trust-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"m3 7 12-4 6 3-12 4-6-3Z\"/>\n          <path d=\"M3 7v9l12 5 1-7\"/>\n          <path d=\"m9 10 6 3\"/>\n          <path d=\"M16 14a4 4 0 1 1-1 2.5\"/>\n          <path d=\"M16 12v4h4\"/>\n        </svg>\n      </span>\n\n      <p class=\"nl-trust-text\">\n        30-DAY RISK-FREE TRIAL ON EVERY PAIR\n      </p>\n    </div>\n\n  </div>\n</div>"
